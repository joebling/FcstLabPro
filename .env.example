# FcstLabPro 环境变量配置
# 复制此文件为 .env 并填入你的 API key:
#   cp .env.example .env
#
# ⚠️  .env 已在 .gitignore 中, 不会提交到 git

# CoinGecko — ETH/BTC Ratio + BTC Dominance
# 免费 Demo key 注册: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# Coinglass — 全网清算/强平数据
# 免费注册: https://www.coinglass.com/
COINGLASS_API_KEY=

# ============================================================
# LLM 策略分析 (可选) — 多 provider 可切换
# ============================================================
# LLM_PROVIDER: gemini (默认) 或 anthropic
LLM_PROVIDER=gemini

# --- provider=gemini ---
# Google AI API Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- provider=anthropic (Anthropic Messages API 格式, 含腾讯 tokenhub 等网关) ---
# 例: DeepSeek via 腾讯 tokenhub
#   LLM_PROVIDER=anthropic
#   LLM_API_KEY=sk-xxxxx              # 你的 key (不要提交到 git!)
#   LLM_BASE_URL=https://tokenhub.tencentmaas.com/
#   LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
